<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <title>Student Data Management</title>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>

    <!-- Bootstrap CSS CDN fallback -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css" crossorigin="anonymous">
    <!-- Font Awesome JS -->
    <script defer src="https://use.fontawesome.com/releases/v5.15.4/js/all.js" crossorigin="anonymous"></script>
  </head>
  <body>
    <% if user_signed_in? %>
      <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <a class="navbar-brand font-weight-bold" href="<%= root_path %>">Student Data Management</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav ml-auto">
            <li class="nav-item text-light d-flex align-items-center mr-3">
              Logged in as <strong class="ml-1"><%= current_user.email %></strong>
            </li>
          </ul>
        </div>
      </nav>
    <% end %>

    <div class="container-fluid py-4">
      <% if user_signed_in? %>
        <div class="row">
          <div id="sidebar-container" class="col-md-3 col-lg-2 mb-4">
            <div class="list-group shadow-sm">
              <span class="list-group-item list-group-item-secondary font-weight-bold text-uppercase small">
                Main Menu
              </span>
              <% current_user.menu_permissions.includes(:menu).where(read: true).each do |aprove| %>
                <% if aprove.menu&.is_active %>
                  <%= link_to aprove.menu.menu_name.titleize, aprove.menu.menu_route, class: 'list-group-item list-group-item-action' %>
                <% end %>
              <% end %>
              <%= link_to 'Edit Profile', edit_user_registration_path, class: 'list-group-item list-group-item-warning' %>
              <%= link_to "Logout", destroy_user_session_path, method: :delete, data: { confirm: 'Apakah Anda yakin ingin keluar?' }, class: 'list-group-item list-group-item-danger' %>
            </div>
          </div> <!-- End Sidebar -->

          <!-- MAIN CONTENT WITH SIDEBAR -->
          <div class="col-md-9 col-lg-10">
            <% if notice %>
              <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= notice %>
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                  <span aria-hidden="true">&times;</span>
                </button>
              </div>
            <% end %>
            <% if alert %>
              <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= alert %>
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                  <span aria-hidden="true">&times;</span>
                </button>
              </div>
            <% end %>
            <%= yield %>
          </div>
        </div>
      <% else %>
        <!-- MAIN CONTENT FOR GUESTS -->
        <div class="row justify-content-center">
          <div class="col-md-8">
            <% if notice %>
              <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= notice %>
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                  <span aria-hidden="true">&times;</span>
                </button>
              </div>
            <% end %>
            <% if alert %>
              <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= alert %>
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                  <span aria-hidden="true">&times;</span>
                </button>
              </div>
            <% end %>
            <%= yield %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Popper.JS & Bootstrap JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js" crossorigin="anonymous"></script>
  </body>
</html>