<%= form_with(model: menu_permission, local: true) do |form| %>
  <% if menu_permission.errors.any? %>
    <div class="alert alert-danger" id="error_explanation">
      <h5 class="alert-heading"><%= pluralize(menu_permission.errors.count, "error") %> prohibited this menu_permission from being saved:</h5>
      <ul class="mb-0">
        <% menu_permission.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :menu_id, "Menu" %>
    <%= form.select(:menu_id, Menu.all.map {|m| [m.menu_name.titleize, m.id]}, { prompt: "-- Pilih Menu --" }, class: "form-control") %>
  </div>

  <div class="form-group">
    <%= form.label :user_id, "User Email" %>
    <%= form.select(:user_id, User.all.map {|u| [u.email, u.id]}, { prompt: "-- Pilih User --" }, class: "form-control") %>
  </div>

  <div class="card bg-light mb-3">
    <div class="card-header font-weight-bold">Hak Akses Modul</div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-3">
          <div class="form-group form-check">
            <%= form.check_box :create, class: "form-check-input", id: "perm_create" %>
            <%= form.label :create, "Create (Tambah)", class: "form-check-label", for: "perm_create" %>
          </div>
        </div>
        <div class="col-md-3">
          <div class="form-group form-check">
            <%= form.check_box :read, class: "form-check-input", id: "perm_read" %>
            <%= form.label :read, "Read (Lihat)", class: "form-check-label", for: "perm_read" %>
          </div>
        </div>
        <div class="col-md-3">
          <div class="form-group form-check">
            <%= form.check_box :uptodate, class: "form-check-input", id: "perm_update" %>
            <%= form.label :uptodate, "Update (Edit)", class: "form-check-label", for: "perm_update" %>
          </div>
        </div>
        <div class="col-md-3">
          <div class="form-group form-check">
            <%= form.check_box :remove, class: "form-check-input", id: "perm_remove" %>
            <%= form.label :remove, "Delete (Hapus)", class: "form-check-label", for: "perm_remove" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="form-group text-right">
    <%= link_to 'Kembali', menu_permissions_path, class: 'btn btn-secondary mr-2' %>
    <%= form.submit "Simpan", class: "btn btn-primary" %>
  </div>
<% end %>

