<div class="card-glass p-4 p-md-5 shadow-lg border-0 rounded-4">
  <div class="text-center mb-4">
    <div class="rounded-circle p-3 text-white d-inline-flex align-items-center justify-content-center mb-3" style="background: var(--primary-gradient); width: 64px; height: 64px;">
      <i class="fa-solid fa-user-lock fs-2"></i>
    </div>
    <h3 class="fw-bold mb-1">Masuk ke Akun Anda</h3>
    <p class="text-muted small">Student Data Management System</p>
  </div>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="mb-3">
      <%= f.label :email, "Alamat Email", class: "form-label fw-semibold" %>
      <div class="input-group">
        <span class="input-group-text bg-transparent border-end-0"><i class="fa-solid fa-envelope text-muted"></i></span>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control border-start-0 ps-0 rounded-end-3", placeholder: "nama@sekolah.sch.id", required: true %>
      </div>
    </div>

    <div class="mb-3">
      <%= f.label :password, "Kata Sandi", class: "form-label fw-semibold" %>
      <div class="input-group">
        <span class="input-group-text bg-transparent border-end-0"><i class="fa-solid fa-key text-muted"></i></span>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-control border-start-0 ps-0 rounded-end-3", placeholder: "••••••••", required: true %>
      </div>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="form-check mb-4">
        <%= f.check_box :remember_me, class: "form-check-input" %>
        <%= f.label :remember_me, "Ingat saya di perangkat ini", class: "form-check-label text-muted small" %>
      </div>
    <% end %>

    <button type="submit" class="btn btn-primary w-100 py-2.5 rounded-3 fw-bold shadow-sm mb-3" style="background: var(--primary-gradient); border: none;">
      <i class="fa-solid fa-right-to-bracket me-2"></i> Masuk Sekarang
    </button>
  <% end %>

  <div class="text-center mt-3">
    <%= render "devise/shared/links" %>
  </div>
</div>
