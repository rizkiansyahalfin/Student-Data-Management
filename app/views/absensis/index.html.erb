<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
  <div>
    <h3 class="fw-bold mb-1"><i class="fa-solid fa-calendar-check text-primary me-2"></i>Presensi Harian Siswa</h3>
    <p class="text-muted mb-0">Kelola dan rekapitulasi kehadiran siswa harian</p>
  </div>
  <div>
    <%= link_to '<i class="fa-solid fa-plus me-1"></i> Input Presensi Baru'.html_safe, new_absensi_path(tanggal: @tanggal, rombel_id: @rombel_id), class: 'btn btn-primary rounded-3 px-3 shadow-sm' %>
  </div>
</div>

<!-- FILTER CARD -->
<div class="card-glass p-4 mb-4">
  <form method="get" action="<%= absensis_path %>" class="row g-3 align-items-end">
    <div class="col-md-4">
      <label class="form-label fw-semibold">Pilih Tanggal Presensi</label>
      <input type="date" name="tanggal" class="form-control rounded-3" value="<%= @tanggal %>">
    </div>
    <div class="col-md-5">
      <label class="form-label fw-semibold">Filter Rombel (Kelas)</label>
      <select name="rombel_id" class="form-select rounded-3">
        <option value="">-- Semua Rombel --</option>
        <% @rombels.each do |r| %>
          <option value="<%= r.id %>" <%= 'selected' if @rombel_id.to_s == r.id.to_s %>><%= r.rombel %></option>
        <% end %>
      </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
      <button type="submit" class="btn btn-primary rounded-3 w-100"><i class="fa-solid fa-filter me-1"></i> Filter</button>
      <%= link_to 'Reset', absensis_path, class: 'btn btn-outline-secondary rounded-3' %>
    </div>
  </form>
</div>

<!-- REKAP SUMMARY CARDS -->
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="card-glass p-3 border-start border-4 border-success">
      <div class="text-muted small text-uppercase fw-bold">Hadir</div>
      <div class="fs-3 fw-bold text-success"><%= @absensis.hadir.count %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card-glass p-3 border-start border-4 border-warning">
      <div class="text-muted small text-uppercase fw-bold">Sakit</div>
      <div class="fs-3 fw-bold text-warning"><%= @absensis.sakit.count %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card-glass p-3 border-start border-4 border-info">
      <div class="text-muted small text-uppercase fw-bold">Izin</div>
      <div class="fs-3 fw-bold text-info"><%= @absensis.izin.count %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card-glass p-3 border-start border-4 border-danger">
      <div class="text-muted small text-uppercase fw-bold">Alpa</div>
      <div class="fs-3 fw-bold text-danger"><%= @absensis.alpa.count %></div>
    </div>
  </div>
</div>

<!-- DATA TABLE -->
<div class="card-glass p-4">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>No</th>
          <th>Nama Siswa</th>
          <th>Rombel</th>
          <th>Tanggal</th>
          <th>Status Presensi</th>
          <th>Keterangan</th>
          <th class="text-end">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if @absensis.any? %>
          <% @absensis.each_with_index do |absensi, index| %>
            <tr>
              <td><%= index + 1 %></td>
              <td class="fw-semibold"><%= absensi.siswa&.nama %></td>
              <td><span class="badge bg-light text-dark border"><%= absensi.siswa&.rombel&.rombel %></span></td>
              <td><%= absensi.tanggal.strftime('%d %b %Y') %></td>
              <td>
                <% case absensi.status_presensi %>
                <% when 'Hadir' %>
                  <span class="badge badge-soft-success px-3 py-2 rounded-pill"><i class="fa-solid fa-check me-1"></i> Hadir</span>
                <% when 'Sakit' %>
                  <span class="badge badge-soft-warning px-3 py-2 rounded-pill"><i class="fa-solid fa-notes-medical me-1"></i> Sakit</span>
                <% when 'Izin' %>
                  <span class="badge badge-soft-primary px-3 py-2 rounded-pill"><i class="fa-solid fa-envelope me-1"></i> Izin</span>
                <% when 'Alpa' %>
                  <span class="badge badge-soft-danger px-3 py-2 rounded-pill"><i class="fa-solid fa-xmark me-1"></i> Alpa</span>
                <% end %>
              </td>
              <td class="text-muted small"><%= absensi.keterangan.presence || '-' %></td>
              <td class="text-end">
                <%= link_to '<i class="fa-solid fa-pen-to-square"></i>'.html_safe, edit_absensi_path(absensi), class: 'btn btn-sm btn-outline-primary rounded-2 me-1' %>
                <%= link_to '<i class="fa-solid fa-trash"></i>'.html_safe, absensi_path(absensi), method: :delete, data: { confirm: 'Hapus catatan presensi ini?' }, class: 'btn btn-sm btn-outline-danger rounded-2' %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="7" class="text-center py-5 text-muted">
              <i class="fa-solid fa-clipboard-question fs-1 d-block mb-3 opacity-50"></i>
              Belum ada data presensi pada tanggal <%= @tanggal.strftime('%d %B %Y') %>.
              <div class="mt-3">
                <%= link_to 'Input Presensi Sekarang', new_absensi_path(tanggal: @tanggal, rombel_id: @rombel_id), class: 'btn btn-sm btn-primary rounded-3' %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
