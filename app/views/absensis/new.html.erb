<div class="mb-4">
  <%= link_to '<i class="fa-solid fa-arrow-left me-1"></i> Kembali'.html_safe, absensis_path(tanggal: @tanggal), class: 'btn btn-outline-secondary btn-sm rounded-3 mb-2' %>
  <h3 class="fw-bold mb-1"><i class="fa-solid fa-pen-line text-primary me-2"></i>Input Presensi Harian Siswa</h3>
  <p class="text-muted">Pilih rombel dan catat kehadiran siswa untuk tanggal <strong><%= @tanggal.strftime('%d %B %Y') %></strong></p>
</div>

<!-- ROMBEL & DATE SELECTOR -->
<div class="card-glass p-4 mb-4">
  <form method="get" action="<%= new_absensi_path %>" class="row g-3 align-items-end">
    <div class="col-md-5">
      <label class="form-label fw-semibold">Pilih Tanggal</label>
      <input type="date" name="tanggal" class="form-control rounded-3" value="<%= @tanggal %>" onchange="this.form.submit()">
    </div>
    <div class="col-md-5">
      <label class="form-label fw-semibold">Pilih Rombel (Kelas)</label>
      <select name="rombel_id" class="form-select rounded-3" onchange="this.form.submit()">
        <option value="">-- Pilih Rombel --</option>
        <% @rombels.each do |r| %>
          <option value="<%= r.id %>" <%= 'selected' if @rombel_id.to_s == r.id.to_s %>><%= r.rombel %></option>
        <% end %>
      </select>
    </div>
    <div class="col-md-2">
      <button type="submit" class="btn btn-primary rounded-3 w-100">Muat Siswa</button>
    </div>
  </form>
</div>

<% if @attendance_data.any? %>
  <%= form_with url: bulk_create_absensis_path, method: :post, local: true do |f| %>
    <%= hidden_field_tag :tanggal, @tanggal %>
    <%= hidden_field_tag :rombel_id, @rombel_id %>

    <div class="card-glass p-4 mb-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">Daftar Siswa (<%= @attendance_data.size %> siswa)</h5>
        <div class="btn-group btn-group-sm">
          <button type="button" class="btn btn-outline-success" onclick="setAllStatus('Hadir')">Set Semua Hadir</button>
          <button type="button" class="btn btn-outline-warning" onclick="setAllStatus('Sakit')">Set Semua Sakit</button>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th>No</th>
              <th>NISN / NIS</th>
              <th>Nama Siswa</th>
              <th>Status Presensi</th>
              <th>Keterangan</th>
            </tr>
          </thead>
          <tbody>
            <% @attendance_data.each_with_index do |absensi, index| %>
              <% siswa = absensi.siswa %>
              <tr>
                <td><%= index + 1 %></td>
                <td><small class="text-muted"><%= siswa.nisn.presence || siswa.nis.presence || '-' %></small></td>
                <td class="fw-semibold"><%= siswa.nama %></td>
                <td>
                  <div class="btn-group w-100" role="group">
                    <% Absensi::STATUS_LIST.each do |st| %>
                      <input type="radio" class="btn-check status-radio" name="attendances[<%= siswa.id %>][status_presensi]" id="st_<%= siswa.id %>_<%= st %>" value="<%= st %>" <%= 'checked' if (absensi.status_presensi || 'Hadir') == st %>>
                      <label class="btn btn-sm btn-outline-<%= st == 'Hadir' ? 'success' : st == 'Sakit' ? 'warning' : st == 'Izin' ? 'primary' : 'danger' %>" for="st_<%= siswa.id %>_<%= st %>">
                        <%= st %>
                      </label>
                    <% end %>
                  </div>
                </td>
                <td>
                  <input type="text" name="attendances[<%= siswa.id %>][keterangan]" class="form-control form-control-sm rounded-2" placeholder="Catatan (opsional)" value="<%= absensi.keterangan %>">
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mb-5">
      <%= link_to 'Batal', absensis_path, class: 'btn btn-outline-secondary rounded-3 px-4' %>
      <button type="submit" class="btn btn-primary rounded-3 px-5 fw-bold shadow-sm"><i class="fa-solid fa-floppy-disk me-1"></i> Simpan Presensi</button>
    </div>
  <% end %>
<% elsif @rombel_id.present? %>
  <div class="card-glass p-5 text-center text-muted">
    <i class="fa-solid fa-user-slash fs-1 opacity-50 mb-3"></i>
    <p>Tidak ada siswa aktif ditemukan di rombel ini.</p>
  </div>
<% else %>
  <div class="card-glass p-5 text-center text-muted">
    <i class="fa-solid fa-arrow-up fs-2 text-primary opacity-75 mb-3"></i>
    <p>Silakan pilih Rombel terlebih dahulu di atas untuk memuat daftar siswa.</p>
  </div>
<% end %>

<script>
  function setAllStatus(status) {
    const radios = document.querySelectorAll(`.status-radio[value="${status}"]`);
    radios.forEach(r => r.checked = true);
  }
</script>
