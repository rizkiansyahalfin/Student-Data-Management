<%= form_with(model: siswa, local: true) do |form| %>
  <% if siswa.errors.any? %>
    <div class="alert alert-danger" id="error_explanation">
      <h5 class="alert-heading"><%= pluralize(siswa.errors.count, "error") %> prohibited this siswa from being saved:</h5>
      <ul class="mb-0">
        <% siswa.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :nama, "Nama Lengkap" %>
    <%= form.text_field :nama, class: "form-control", placeholder: "Masukkan nama siswa" %>
  </div>

  <div class="form-group">
    <label>Jenis Kelamin</label>
    <div>
      <div class="form-check form-check-inline">
        <%= form.radio_button :jk, 'Laki-laki', class: 'form-check-input', id: 'jk_laki' %>
        <%= form.label :jk, "Laki-laki", class: 'form-check-label', for: 'jk_laki' %>
      </div>
      <div class="form-check form-check-inline">
        <%= form.radio_button :jk, 'Perempuan', class: 'form-check-input', id: 'jk_perempuan' %>
        <%= form.label :jk, "Perempuan", class: 'form-check-label', for: 'jk_perempuan' %>
      </div>
    </div>
  </div>

  <div class="form-group">
    <%= form.label :rombel_id, "Rombel" %>
    <%= form.select(:rombel_id, Rombel.includes(:jurusan).map {|r| ["#{r.jurusan&.jurusan} - #{r.rombel}", r.id]}, { prompt: "-- Pilih Rombel --" }, class: "form-control") %>
  </div>

  <div class="form-group">
    <%= form.label :rayon_id, "Rayon" %>
    <%= form.select(:rayon_id, Rayon.all.map {|r| [r.rayon, r.id]}, { prompt: "-- Pilih Rayon --" }, class: "form-control") %>
  </div>

  <div class="form-group text-right">
    <%= link_to 'Kembali', siswas_path, class: 'btn btn-secondary mr-2' %>
    <%= form.submit "Simpan", class: "btn btn-primary" %>
  </div>
<% end %>

